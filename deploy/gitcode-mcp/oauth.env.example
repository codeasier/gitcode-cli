# Copy outside the repository and restrict the real file to its operator (mode 0600).
# This example contains no credentials. Empty required values prevent startup.
GITCODE_MCP_AUTH_MODE=oauth
GITCODE_MCP_PUBLIC_URL=https://mcp.example.com

# Obtain these from GitCode: Personal settings -> OAuth applications.
# Register https://mcp.example.com/oauth/gitcode/callback in that GitCode application.
GITCODE_OAUTH_CLIENT_ID=
GITCODE_OAUTH_CLIENT_SECRET=
# Optional space-separated GitCode scopes; empty omits the upstream scope parameter.
GITCODE_OAUTH_SCOPES=

# These describe ChatGPT's client of this MCP server, not the GitCode application.
GITCODE_MCP_OAUTH_CLIENT_ID=gitcode-chatgpt
GITCODE_MCP_OAUTH_CLIENT_SECRET=
# Empty permits discovery during setup, but no authorization callback is accepted.
# Then copy the exact callback shown by ChatGPT; comma-separate only allowed URLs.
GITCODE_MCP_OAUTH_REDIRECT_URIS=
# Persistent URL-safe base64 encoding of 32 random bytes (a Fernet key).
GITCODE_MCP_OAUTH_ENCRYPTION_KEY=

# Optional comma-separated stable GitCode user IDs for a private deployment.
GITCODE_MCP_OAUTH_ALLOWED_USER_IDS=
# Empty allows each authorized user's own GitCode repository permissions.
GITCODE_MCP_ALLOWED_REPOS=
GITCODE_MCP_READ_ONLY=true
GITCODE_MCP_ALLOWED_HOSTS=mcp.example.com
GITCODE_MCP_ALLOWED_ORIGINS=https://mcp.example.com

# Never add GITCODE_TOKEN, GC_TOKEN or GITCODE_MCP_HTTP_TOKEN to OAuth mode.
